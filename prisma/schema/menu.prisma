enum VariantType {
  SINGLE
  MULTIPLE
}

model MenuCategory {
  id String @id @default(cuid())
  name String @unique
  icon String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)

  item MenuItem[]
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id String @id @default(cuid())
  categoryId String
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name String
  description String?
  basePrice Decimal @db.Decimal(12,2)
  image String?

  isAvailable Boolean @default(true)
  isFeatured Boolean @default(true)
  totalOrder Int @default(0)
  avgRating Decimal @default(0) @db.Decimal(3,2)
  sortOrder Int @default(0)

  variantGroups VariantGroup[]
  orderItems OrderItem[]
  reviews Review[]
  flashSale FlashSale?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([isAvailable, sortOrder])
  @@index([isFeatured])
  @@map("menu_items")
}

model VariantGroup {
  id String @id @default(cuid())
  itemId String
  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  name String
  type VariantType @default(SINGLE)
  isRequired Boolean @default(true)
  sortOrder Int @default(0)

  options VariantOption[]
  createdAt DateTime @default(now())

  @@index([itemId, sortOrder])
  @@map("variant_groups")
}

model VariantOption {
  id         String       @id @default(cuid())
  groupId    String
  group      VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name       String
  priceAdd   Decimal      @default(0) @db.Decimal(10, 2)
  sortOrder  Int          @default(0)

  createdAt  DateTime     @default(now())

  @@index([groupId, sortOrder])
  @@map("variant_options")
}

model FlashSale {
  id               String   @id @default(cuid())
  itemId           String   @unique
  item             MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  discountPercent  Decimal  @db.Decimal(5, 2)
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean  @default(true)

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt        DateTime @default(now())

  @@index([isActive, endsAt])
  @@index([createdById])
  @@map("flash_sales")
}