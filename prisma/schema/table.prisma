model Table {
  id String @id @default(cuid())
  name String @unique
  qrToken String @unique @default(cuid())
  capacity  Int      @default(2)   // mặc định 2 chỗ
  floor String?     // Tầng 1, Ngoài trời
  isActive Boolean @default(true)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  @@index([qrToken])
  @@index([isActive])
  @@map("tables") // Map tên bảng trong DB là "tables" (số nhiều)
}