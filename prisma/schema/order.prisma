enum OrderType  {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT        // VNPay: vừa tạo, đang chờ trả tiền
  PENDING_CONFIRMATION   // CASH: hoặc VNPay đã trả xong, đang chờ quán xác nhận
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED              // đổi từ PAID -> COMPLETED cho rõ
  CANCELLED
  PAYMENT_FAILED         // thêm để khi VNPay fail
}

enum PaymentStatus {
  PENDING
  PAID
  UNPAID
  FAILED   // thêm FAILED
  REFUNDED
}

enum ItemStatus {
  WAITING
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  VNPAY
  ZALOPAY
  MOMO
  CASH
}

enum VoucherDiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum VoucherDistribution {
  ACCOUNT
  SECRET
}

model Order {
  id String @id @default(cuid())
  orderCode String @unique
  pickupCode String?
  tableId String?
  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  customerId String?
  customer User? @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  confirmedById String?
  confirmedBy User? @relation("ConfirmedByStaff", fields: [confirmedById], references: [id], onDelete: SetNull)

  sessionId String
  type OrderType @default(DINE_IN)
  status OrderStatus @default(PENDING_CONFIRMATION)
  note String?
  cancelReason String?

  subtotal Decimal @db.Decimal(14, 2) @default(0)
  vatAmount Decimal @db.Decimal(14,2) @default(0)
  discountAmount Decimal @db.Decimal(14,2) @default(0)
  totalAmount Decimal @db.Decimal(14,2) @default(0)

  voucherId String?
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode String?

  confirmAt DateTime?
  readyAt DateTime?
  servedAt DateTime?
  paidAt DateTime?
  deliveryInfo Json?
  expireAt DateTime?


  items OrderItem[]
  payments Payment[]
  reviews Review[]
  voucherUsage VoucherUsage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId, status])
  @@index([status])
  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
  @@map("orders")

}

model Voucher {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  discountType VoucherDiscountType
  distribution VoucherDistribution @default(SECRET)
  discountValue Decimal @db.Decimal(14,2)
  minOrderAmount Decimal @db.Decimal(14,2) @default(0)
  maxDiscountAmount Decimal? @db.Decimal(14,2)
  applicableOrderTypes OrderType[] @default([DINE_IN, TAKEAWAY, DELIVERY])
  startsAt DateTime
  endsAt DateTime
  usageLimit Int?
  usedCount Int @default(0)
  perCustomerLimit Int @default(1)
  isActive Boolean @default(true)
  orders Order[]
  usages VoucherUsage[]
  wallets VoucherWallet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("vouchers")
}

model VoucherWallet {
  id String @id @default(cuid())
  voucherId String
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivedAt DateTime @default(now())

  @@unique([voucherId, customerId])
  @@index([customerId, receivedAt(sort: Desc)])
  @@map("voucher_wallets")
}

model VoucherUsage {
  id String @id @default(cuid())
  voucherId String
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer User? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountAmount Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())

  @@index([voucherId, customerId])
  @@map("voucher_usages")
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  subTotal Decimal @db.Decimal(14,2)

  snapshot Json @default("{}")
  status ItemStatus @default(WAITING)
  note String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@index([orderId])
  @@index([orderId, status])
  @@map("order_items")
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14, 2)
  txnRef String? @unique
  gatewayData Json @default("{}")
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([txnRef])
  @@index([status])
  @@map("payments")
}

model Review {
  id String @id @default(cuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  rating Int
  comment String?
  images String[]

  createdAt DateTime @default(now())
  @@unique([customerId, menuItemId, orderId])
  @@index([menuItemId, rating])
  @@index([customerId])
  @@map("reviews")
}
