enum OrderType  {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum ItemStatus {
  WAITING
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  VNPAY
  MOMO
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Order {
  id String @id @default(cuid())
  pickupCode String?
  tableId String?
  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  customerId String?
  customer User? @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  confirmedById String?
  confirmedBy User? @relation("ConfirmedByStaff", fields: [confirmedById], references: [id], onDelete: SetNull)

  sessionId String
  type OrderType @default(DINE_IN)
  status OrderStatus @default(PENDING)
  note String?
  cancelReason String?

  subtotal Decimal @db.Decimal(14, 2) @default(0)
  vatAmount Decimal @db.Decimal(14,2) @default(0)
  totalAmount Decimal @db.Decimal(14,2) @default(0)

  confirmAt DateTime?
  readyAt DateTime?
  servedAt DateTime?
  paidAt DateTime?
  deliveryInfo Json?


  items OrderItem[]
  payments Payment[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId, status])
  @@index([status])
  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
  @@map("orders")

}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  subTotal Decimal @db.Decimal(14,2)

  snapshot Json @default("{}")
  status ItemStatus @default(WAITING)
  note String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@index([orderId])
  @@index([orderId, status])
  @@map("order_items")
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14, 2)
  txnRef String? @unique
  gatewayData Json @default("{}")
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([txnRef])
  @@index([status])
  @@map("payments")
}

model Review {
  id String @id @default(cuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  rating Int
  comment String?
  images String[]

  createdAt DateTime @default(now())
  @@unique([customerId, menuItemId, orderId])
  @@index([menuItemId, rating])
  @@index([customerId])
  @@map("reviews")
}